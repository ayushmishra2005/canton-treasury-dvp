import com.daml.ledger.api.v2.commands.{Command, ExerciseCommand}
import com.daml.ledger.api.v2.value.{Identifier, Record, RecordField, Value}
import com.digitalasset.canton.admin.api.client.commands.LedgerApiTypeWrappers
import com.digitalasset.canton.admin.api.client.commands.LedgerApiTypeWrappers
import com.digitalasset.canton.admin.api.client.commands.LedgerApiTypeWrappers.WrappedContractEntry
import com.digitalasset.canton.console.{CommandFailure, RemoteParticipantReference}
import com.digitalasset.canton.topology.{PartyId, SynchronizerId}
import com.digitalasset.daml.lf.value.Value.ContractId
import java.nio.file.{Files, Paths}

val settlementAlias = "settlement-sync"
val treasuryAlias = "treasury-sync"

val pTreasury = participants.remote.find(_.name == "p-treasury").getOrElse(sys.error("missing p-treasury"))
val pSeller = participants.remote.find(_.name == "p-seller").getOrElse(sys.error("missing p-seller"))

val participantNames = Seq("p-treasury", "p-cash", "p-seller", "p-buyer", "p-venue", "p-outsider")
val runDir = Paths.get(sys.env.getOrElse("CANTON_RUN_DIR", "canton/.run"))
Files.createDirectories(runDir)
val probeCheckpoints = participantNames.map { name =>
  val node = participants.remote.find(_.name == name).getOrElse(sys.error(s"missing $name"))
  s"$name=${node.ledger_api.state.end()}"
}
Files.write(runDir.resolve("probe-start.txt"), probeCheckpoints.mkString("\n").getBytes("UTF-8"))
probeCheckpoints.foreach(line => println(s"PROBE_CHECKPOINT $line"))

def synchronizerIdOf(alias: String): SynchronizerId =
  pTreasury.synchronizers
    .list_connected()
    .find(_.synchronizerAlias.unwrap == alias)
    .getOrElse(sys.error(s"p-treasury is not connected to $alias"))
    .synchronizerId

val treasurySynchronizerId = synchronizerIdOf(treasuryAlias)
val settlementSynchronizerId = synchronizerIdOf(settlementAlias)

def partyOf(node: RemoteParticipantReference, hint: String): PartyId =
  node.parties
    .hosted()
    .map(_.party)
    .find(_.filterString.startsWith(hint + "::"))
    .getOrElse(sys.error(s"party $hint is not hosted on ${node.name}"))

val treasuryRegistry = partyOf(pTreasury, "treasuryRegistry")
val seller = partyOf(pSeller, "seller")

val instrumentTemplate = Identifier("#treasury-registry", "Treasury.Instrument", "TreasuryInstrument")
val holdingTemplate = Identifier("#treasury-registry", "Treasury.Holding", "TreasuryHolding")

def acsOf(node: RemoteParticipantReference, party: PartyId): Seq[WrappedContractEntry] =
  node.ledger_api.state.acs.of_party(party = party, limit = PositiveInt.tryCreate(1000))
    .filter(_.entry.isActiveContract)

def templateOf(entry: WrappedContractEntry): String =
  entry.event.templateId.map(id => s"${id.moduleName}:${id.entityName}").getOrElse("")

def synchronizerOf(entry: WrappedContractEntry): String =
  entry.synchronizerId.map(_.toProtoPrimitive).getOrElse("")

def eventually(label: String)(condition: => Boolean): Unit = {
  val deadline = System.currentTimeMillis() + 60000
  while (!condition && System.currentTimeMillis() < deadline) Thread.sleep(250)
  if (!condition) sys.error(s"timed out waiting for $label")
}

def recordValue(fields: Seq[(String, Value)]) =
  Record(fields = fields.map { case (name, value) => RecordField(name, Some(value)) })

val instrumentEntry = acsOf(pTreasury, treasuryRegistry)
  .find(templateOf(_) == "Treasury.Instrument:TreasuryInstrument")
  .getOrElse(sys.error("treasury instrument is not active"))

val issueProbe = Command.defaultInstance.withExercise(
  ExerciseCommand(
    templateId = Some(instrumentTemplate),
    contractId = instrumentEntry.contractId,
    choice = "Issue",
    choiceArgument = Some(
      Value(
        Value.Sum.Record(
          recordValue(
            Seq(
              "owner" -> Value(Value.Sum.Party(seller.toProtoPrimitive)),
              "amount" -> Value(Value.Sum.Numeric("5.0000000000")),
            )
          )
        )
      )
    ),
  )
)

val probeTx = pTreasury.ledger_api.commands.submit(
  actAs = Seq(treasuryRegistry),
  commands = Seq(issueProbe),
  synchronizerId = Some(treasurySynchronizerId),
)
val probeCid = probeTx.events
  .flatMap(_.event.created)
  .find(_.templateId.exists(_.entityName == "TreasuryHolding"))
  .getOrElse(sys.error("probe holding was not created"))
  .contractId

def probeEntry(): Option[WrappedContractEntry] =
  acsOf(pSeller, seller).find(_.contractId == probeCid)

def requireProbeOn(label: String, expected: SynchronizerId): WrappedContractEntry = {
  eventually(s"the probe holding to become active for $label")(
    probeEntry().exists(synchronizerOf(_) == expected.toProtoPrimitive)
  )
  probeEntry() match {
    case Some(entry) if synchronizerOf(entry) == expected.toProtoPrimitive =>
      println(s"PROBE_ACTIVE $label ${synchronizerOf(entry)} counter=${entry.reassignmentCounter}")
      entry
    case other => sys.error(s"$label expected on ${expected.toProtoPrimitive} but found $other")
  }
}

val probeCreated = requireProbeOn("created", treasurySynchronizerId)
val probePayload = probeCreated.event.createArguments
val probeCounterStart = probeCreated.reassignmentCounter
println(s"PROBE_HOLDING $probeCid")

val splitProbe = Command.defaultInstance.withExercise(
  ExerciseCommand(
    templateId = Some(holdingTemplate),
    contractId = probeCid,
    choice = "Split",
    choiceArgument =
      Some(Value(Value.Sum.Record(recordValue(Seq("splitAmount" -> Value(Value.Sum.Numeric("2.0000000000"))))))),
  )
)

def splitOn(synchronizerId: SynchronizerId): Option[String] =
  try {
    pSeller.ledger_api.commands.submit(
      actAs = Seq(seller),
      commands = Seq(splitProbe),
      synchronizerId = Some(synchronizerId),
    )
    None
  } catch {
    case failure: CommandFailure => Some(failure.getMessage)
  }

def unassignProbe(source: SynchronizerId, target: SynchronizerId): String = {
  val unassigned = pSeller.ledger_api.commands.submit_unassign(
    submitter = seller,
    contractIds = Seq(ContractId.assertFromString(probeCid)),
    source = source,
    target = target,
  )
  println(s"PROBE_UNASSIGNED id=${unassigned.reassignmentId}")
  unassigned.reassignmentId
}

def assignProbe(reassignmentId: String, source: SynchronizerId, target: SynchronizerId): Unit = {
  pSeller.ledger_api.commands.submit_assign(
    submitter = seller,
    reassignmentId = reassignmentId,
    source = source,
    target = target,
  )
  println(s"PROBE_ASSIGNED id=$reassignmentId")
}

val pendingReassignmentId = unassignProbe(treasurySynchronizerId, settlementSynchronizerId)

eventually("the probe holding to leave both synchronizers")(probeEntry().isEmpty)
println("PROBE_INACTIVE_ON_SOURCE_AND_TARGET")

def pendingProbeEntries(): Seq[LedgerApiTypeWrappers.WrappedIncompleteUnassigned] =
  pSeller.ledger_api.state.acs
    .incomplete_unassigned_of_party(party = seller, limit = PositiveInt.tryCreate(1000))
    .filter(_.contractId == probeCid)

eventually("the probe holding to enter pending assignment")(pendingProbeEntries().nonEmpty)
println(s"PROBE_PENDING entries=${pendingProbeEntries().size}")

splitOn(settlementSynchronizerId) match {
  case Some(_) => println("PROBE_USE_WHILE_PENDING_REJECTED")
  case None => sys.error("using a pending-assignment contract must fail")
}

if (pendingProbeEntries().isEmpty) sys.error("probe holding was lost after the rejected command")
println("PROBE_NOT_LOST")

assignProbe(pendingReassignmentId, treasurySynchronizerId, settlementSynchronizerId)
val probeOnSettlement = requireProbeOn("assigned", settlementSynchronizerId)
if (probeOnSettlement.event.createArguments != probePayload)
  sys.error("probe holding payload changed during assignment")
if (probeOnSettlement.reassignmentCounter != probeCounterStart + 1)
  sys.error(s"probe counter moved from $probeCounterStart to ${probeOnSettlement.reassignmentCounter}")
println("PROBE_PAYLOAD_PRESERVED_AFTER_ASSIGNMENT")

val returnReassignmentId = unassignProbe(settlementSynchronizerId, treasurySynchronizerId)
assignProbe(returnReassignmentId, settlementSynchronizerId, treasurySynchronizerId)
val probeBack = requireProbeOn("round-trip", treasurySynchronizerId)
if (probeBack.event.createArguments != probePayload)
  sys.error("probe holding payload changed during the round trip")
if (probeBack.reassignmentCounter != probeCounterStart + 2)
  sys.error(s"probe counter is ${probeBack.reassignmentCounter} after two reassignments")
println(s"PROBE_ROUND_TRIP_PRESERVED counter=${probeBack.reassignmentCounter}")

splitOn(treasurySynchronizerId) match {
  case None => println("PROBE_USABLE_AFTER_ASSIGNMENT")
  case Some(message) => sys.error(s"probe holding is not usable after assignment: $message")
}

println("PROBE_COMPLETE")
