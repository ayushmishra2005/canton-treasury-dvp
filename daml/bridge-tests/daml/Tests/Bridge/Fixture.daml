module Tests.Bridge.Fixture where

import DA.Assert ((===))
import DA.Optional (isNone)
import Daml.Script

import Splice.Api.Token.HoldingV1

import Bridge.Attestation
import Bridge.Binding
import Bridge.Gateway
import Bridge.Types
import Stablecoin.Holding
import Stablecoin.Instrument

data Fixture = Fixture with
  cashRegistry : Party
  attesterA : Party
  attesterB : Party
  attesterC : Party
  holder : Party
  seller : Party
  venue : Party
  outsider : Party
  instrumentCid : ContractId StablecoinInstrument
  instrumentId : InstrumentId
  gatewayCid : ContractId BridgeGateway

setup : Script Fixture
setup = do
  cashRegistry <- allocateParty "CashRegistry"
  attesterA <- allocateParty "AttesterA"
  attesterB <- allocateParty "AttesterB"
  attesterC <- allocateParty "AttesterC"
  holder <- allocateParty "Holder"
  seller <- allocateParty "Seller"
  venue <- allocateParty "Venue"
  outsider <- allocateParty "Outsider"
  instrumentCid <- submit cashRegistry $ createCmd StablecoinInstrument with
    cashRegistry
    id = "USD-C"
    description = "Regulated USD payment stablecoin"
  let instrumentId = InstrumentId with admin = cashRegistry, id = "USD-C"
  gatewayCid <- submit cashRegistry $ createCmd BridgeGateway with
    cashRegistry
    attesters = [attesterA, attesterB, attesterC]
    instrumentCid
    instrumentId
    mintedLocks = []
    redeemedLocks = []
  pure Fixture with ..

attest : Fixture -> Party -> Text -> Decimal -> Text -> BridgeDirection -> Script (ContractId BridgeAttestation)
attest fixture attester lockId amount digestHex direction =
  attestFull fixture attester lockId amount digestHex direction fixture.instrumentId ""

attestFull :
  Fixture -> Party -> Text -> Decimal -> Text -> BridgeDirection -> InstrumentId -> Text ->
  Script (ContractId BridgeAttestation)
attestFull fixture attester lockId amount digestHex direction instrumentId payoutDestination =
  submit attester $ createCmd BridgeAttestation with
    attester
    cashRegistry = fixture.cashRegistry
    lockId
    amount
    beneficiary = fixture.holder
    digestHex
    direction
    instrumentId
    payoutDestination

attestFor :
  Fixture -> Party -> Party -> Text -> Decimal -> Text -> BridgeDirection -> Text ->
  Script (ContractId BridgeAttestation)
attestFor fixture attester beneficiary lockId amount digestHex direction payoutDestination =
  submit attester $ createCmd BridgeAttestation with
    attester
    cashRegistry = fixture.cashRegistry
    lockId
    amount
    beneficiary
    digestHex
    direction
    instrumentId = fixture.instrumentId
    payoutDestination

currentGateway : Fixture -> Script (ContractId BridgeGateway)
currentGateway fixture = do
  found <- query @BridgeGateway fixture.cashRegistry
  case found of
    [(cid, _)] -> pure cid
    _ -> abort "expected one bridge gateway"

currentMintedLock : Fixture -> Text -> Script (ContractId MintedLock)
currentMintedLock fixture lockId = do
  found <- query @MintedLock fixture.cashRegistry
  case [cid | (cid, minted) <- found, minted.lockId == lockId] of
    [cid] -> pure cid
    _ -> abort ("expected one minted lock " <> lockId)

mintWith : Fixture -> Party -> Party -> Text -> Decimal -> Text -> Script (ContractId StablecoinHolding)
mintWith fixture first second lockId amount digestHex = do
  firstCid <- attest fixture first lockId amount digestHex MintAttestation
  secondCid <- attest fixture second lockId amount digestHex MintAttestation
  gatewayCid <- currentGateway fixture
  (_next, holdingCid) <- submit fixture.cashRegistry $ exerciseCmd gatewayCid Gateway_Mint with
    firstCid
    secondCid
  pure holdingCid

holdingUnchanged : Party -> ContractId StablecoinHolding -> Decimal -> Script ()
holdingUnchanged owner holdingCid amount = do
  Some holding <- queryContractId owner holdingCid
  holding.amount === amount
  isNone holding.lock === True

gatewayUnchanged : Fixture -> ContractId BridgeGateway -> Script ()
gatewayUnchanged fixture expected = do
  actual <- currentGateway fixture
  actual === expected

currentMintRef : Fixture -> Text -> Script (ContractId BridgeMintRef)
currentMintRef fixture lockId = do
  found <- query @BridgeMintRef fixture.holder
  case [cid | (cid, ref) <- found, ref.lockId == lockId] of
    [cid] -> pure cid
    _ -> abort ("expected one mint reference " <> lockId)

currentBinding : Fixture -> Text -> Script (ContractId BridgeTradeBinding)
currentBinding fixture lockId = do
  found <- query @BridgeTradeBinding fixture.holder
  case [cid | (cid, binding) <- found, binding.lockId == lockId] of
    [cid] -> pure cid
    _ -> abort ("expected one trade binding " <> lockId)

bindMint : Fixture -> Text -> Text -> Script (ContractId BridgeTradeBinding)
bindMint fixture lockId tradeCid = do
  refCid <- currentMintRef fixture lockId
  submit fixture.holder $ exerciseCmd refCid BridgeMintRef_Bind with
    seller = fixture.seller
    venue = fixture.venue
    tradeCid

issueSellerHolding : Fixture -> Decimal -> Script (ContractId StablecoinHolding)
issueSellerHolding fixture amount =
  submit fixture.cashRegistry $ exerciseCmd fixture.instrumentCid Mint with
    owner = fixture.seller
    amount

recordSellerPayment : Fixture -> ContractId BridgeTradeBinding -> ContractId StablecoinHolding -> Script (ContractId BridgeTradeBinding)
recordSellerPayment fixture bindingCid holdingCid =
  submit fixture.seller $ exerciseCmd bindingCid BridgeTradeBinding_RecordPayment with
    recordedPaymentCid = holdingCid

mintedLockUnchanged : Fixture -> Text -> ContractId MintedLock -> Script ()
mintedLockUnchanged fixture lockId expected = do
  actual <- currentMintedLock fixture lockId
  actual === expected
  Some minted <- queryContractId fixture.cashRegistry expected
  minted.lockId === lockId

bindingUnchanged : Fixture -> Text -> ContractId BridgeTradeBinding -> Script ()
bindingUnchanged fixture lockId expected = do
  actual <- currentBinding fixture lockId
  actual === expected
  Some binding <- queryContractId fixture.holder expected
  binding.lockId === lockId

prepareBoundRedeem : Fixture -> Text -> Decimal -> Text -> Text -> Script (ContractId StablecoinHolding, ContractId BridgeTradeBinding, ContractId MintedLock)
prepareBoundRedeem fixture lockId amount mintDigest tradeCid = do
  _mintHolding <- mintWith fixture fixture.attesterA fixture.attesterB lockId amount mintDigest
  mintedLockCid <- currentMintedLock fixture lockId
  bound <- bindMint fixture lockId tradeCid
  sellerHolding <- issueSellerHolding fixture amount
  bindingCid <- recordSellerPayment fixture bound sellerHolding
  pure (sellerHolding, bindingCid, mintedLockCid)
