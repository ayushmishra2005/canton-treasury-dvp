module Tests.Bridge.Redemption where

import DA.Assert ((===))
import DA.Optional (isNone)
import Daml.Script

import Bridge.Gateway
import Bridge.Types
import Stablecoin.Instrument
import Tests.Bridge.Fixture

burnBeforeRelease : Script ()
burnBeforeRelease = do
  fixture <- setup
  holdingCid <- mintWith fixture fixture.attesterA fixture.attesterB "lock-1" 100000.0 "digest-1"
  mintedLockCid <- currentMintedLock fixture "lock-1"
  requestCid <- submit fixture.holder $ createCmd RedemptionRequest with
    holder = fixture.holder
    cashRegistry = fixture.cashRegistry
    lockId = "lock-1"
    holdingCid
    amount = 100000.0
    digestHex = "redeem-1"
    instrumentId = fixture.instrumentId
    payoutDestination = "seller-solana-dest"
  firstCid <- attestFor fixture fixture.attesterA fixture.holder "lock-1" 100000.0 "redeem-1" RedeemAttestation "seller-solana-dest"
  secondCid <- attestFor fixture fixture.attesterC fixture.holder "lock-1" 100000.0 "redeem-1" RedeemAttestation "seller-solana-dest"
  gatewayCid <- currentGateway fixture
  (_next, redeemedCid) <- submit fixture.cashRegistry $ exerciseCmd gatewayCid Gateway_Redeem with
    requestCid
    firstCid
    secondCid
    mintedLockCid
  Some redeemed <- queryContractId fixture.cashRegistry redeemedCid
  redeemed.lockId === "lock-1"
  redeemed.amount === 100000.0
  after <- queryContractId fixture.holder holdingCid
  isNone after === True

cannotRedeemTwice : Script ()
cannotRedeemTwice = do
  fixture <- setup
  holdingCid <- mintWith fixture fixture.attesterA fixture.attesterB "lock-1" 100000.0 "digest-1"
  mintedLockCid <- currentMintedLock fixture "lock-1"
  requestCid <- submit fixture.holder $ createCmd RedemptionRequest with
    holder = fixture.holder
    cashRegistry = fixture.cashRegistry
    lockId = "lock-1"
    holdingCid
    amount = 100000.0
    digestHex = "redeem-1"
    instrumentId = fixture.instrumentId
    payoutDestination = "seller-solana-dest"
  firstCid <- attestFor fixture fixture.attesterA fixture.holder "lock-1" 100000.0 "redeem-1" RedeemAttestation "seller-solana-dest"
  secondCid <- attestFor fixture fixture.attesterB fixture.holder "lock-1" 100000.0 "redeem-1" RedeemAttestation "seller-solana-dest"
  gatewayCid <- currentGateway fixture
  _ <- submit fixture.cashRegistry $ exerciseCmd gatewayCid Gateway_Redeem with
    requestCid
    firstCid
    secondCid
    mintedLockCid
  replacement <- submit fixture.cashRegistry $ exerciseCmd fixture.instrumentCid Mint with
    owner = fixture.holder
    amount = 100000.0
  retryRequest <- submit fixture.holder $ createCmd RedemptionRequest with
    holder = fixture.holder
    cashRegistry = fixture.cashRegistry
    lockId = "lock-1"
    holdingCid = replacement
    amount = 100000.0
    digestHex = "redeem-2"
    instrumentId = fixture.instrumentId
    payoutDestination = "seller-solana-dest"
  retryFirst <- attestFor fixture fixture.attesterA fixture.holder "lock-1" 100000.0 "redeem-2" RedeemAttestation "seller-solana-dest"
  retrySecond <- attestFor fixture fixture.attesterB fixture.holder "lock-1" 100000.0 "redeem-2" RedeemAttestation "seller-solana-dest"
  afterRedeem <- currentGateway fixture
  submitMustFail fixture.cashRegistry $ exerciseCmd afterRedeem Gateway_Redeem with
    requestCid = retryRequest
    firstCid = retryFirst
    secondCid = retrySecond
    mintedLockCid
  holdingUnchanged fixture.holder replacement 100000.0
  gatewayUnchanged fixture afterRedeem

cannotRedeemUnmintedLock : Script ()
cannotRedeemUnmintedLock = do
  fixture <- setup
  holdingCid <- mintWith fixture fixture.attesterA fixture.attesterB "lock-1" 100000.0 "digest-1"
  mintedLockCid <- currentMintedLock fixture "lock-1"
  otherHolding <- submit fixture.cashRegistry $ exerciseCmd fixture.instrumentCid Mint with
    owner = fixture.holder
    amount = 100000.0
  requestCid <- submit fixture.holder $ createCmd RedemptionRequest with
    holder = fixture.holder
    cashRegistry = fixture.cashRegistry
    lockId = "never-locked"
    holdingCid = otherHolding
    amount = 100000.0
    digestHex = "redeem-1"
    instrumentId = fixture.instrumentId
    payoutDestination = "seller-solana-dest"
  firstCid <- attestFor fixture fixture.attesterA fixture.holder "never-locked" 100000.0 "redeem-1" RedeemAttestation "seller-solana-dest"
  secondCid <- attestFor fixture fixture.attesterB fixture.holder "never-locked" 100000.0 "redeem-1" RedeemAttestation "seller-solana-dest"
  gatewayCid <- currentGateway fixture
  submitMustFail fixture.cashRegistry $ exerciseCmd gatewayCid Gateway_Redeem with
    requestCid
    firstCid
    secondCid
    mintedLockCid
  holdingUnchanged fixture.holder holdingCid 100000.0
  holdingUnchanged fixture.holder otherHolding 100000.0
  gatewayUnchanged fixture gatewayCid
