module Integration.Topology where

import DA.Foldable (forA_)
import DA.List (sortOn)
import DA.Text qualified as Text
import Daml.Script

data Topology = Topology with
  treasuryRegistry : Party
  cashRegistry : Party
  seller : Party
  buyer : Party
  venue : Party
  outsider : Party

treasuryParticipant : Text
treasuryParticipant = "p-treasury"

cashParticipant : Text
cashParticipant = "p-cash"

sellerParticipant : Text
sellerParticipant = "p-seller"

buyerParticipant : Text
buyerParticipant = "p-buyer"

venueParticipant : Text
venueParticipant = "p-venue"

outsiderParticipant : Text
outsiderParticipant = "p-outsider"

allocateOn : Text -> Text -> Script Party
allocateOn hint participant =
  allocatePartyByHintOn (PartyIdHint hint) (ParticipantName participant)

allocateTopology : Script Topology
allocateTopology = do
  treasuryRegistry <- allocateOn "treasuryRegistry" treasuryParticipant
  cashRegistry <- allocateOn "cashRegistry" cashParticipant
  seller <- allocateOn "seller" sellerParticipant
  buyer <- allocateOn "buyer" buyerParticipant
  venue <- allocateOn "venue" venueParticipant
  outsider <- allocateOn "outsider" outsiderParticipant
  pure Topology with ..

lookupOn : Text -> Text -> Script Party
lookupOn hint participant = do
  known <- listKnownPartiesOn (ParticipantName participant)
  let matches =
        [ details.party
        | details <- known
        , details.isLocal
        , Text.isPrefixOf (hint <> "::") (partyToText details.party)
        ]
  case sortOn partyToText matches of
    [party] -> pure party
    _ -> abort ("Expected exactly one party " <> hint <> " hosted on " <> participant)

lookupTopology : Script Topology
lookupTopology = do
  treasuryRegistry <- lookupOn "treasuryRegistry" treasuryParticipant
  cashRegistry <- lookupOn "cashRegistry" cashParticipant
  seller <- lookupOn "seller" sellerParticipant
  buyer <- lookupOn "buyer" buyerParticipant
  venue <- lookupOn "venue" venueParticipant
  outsider <- lookupOn "outsider" outsiderParticipant
  pure Topology with ..

hostingMap : Topology -> [(Text, Party)]
hostingMap topology =
  [ (treasuryParticipant, topology.treasuryRegistry)
  , (cashParticipant, topology.cashRegistry)
  , (sellerParticipant, topology.seller)
  , (buyerParticipant, topology.buyer)
  , (venueParticipant, topology.venue)
  , (outsiderParticipant, topology.outsider)
  ]

assertExclusiveHosting : Topology -> Script ()
assertExclusiveHosting topology = do
  let hosts = hostingMap topology
  forA_ hosts $ \(host, party) ->
    forA_ hosts $ \(candidate, _) -> do
      known <- listKnownPartiesOn (ParticipantName candidate)
      let hostedLocally = [details | details <- known, details.party == party, details.isLocal]
      if host == candidate
        then assertMsg
          ("Party " <> partyToText party <> " must be hosted on " <> host)
          (length hostedLocally == 1)
        else assertMsg
          ("Party " <> partyToText party <> " must not be hosted on " <> candidate)
          (null hostedLocally)
