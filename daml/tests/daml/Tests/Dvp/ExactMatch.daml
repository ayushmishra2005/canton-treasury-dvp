module Tests.Dvp.ExactMatch where

import DA.Assert ((===))
import DA.Date (Month(..), date)
import DA.Time (addRelTime, minutes)
import Daml.Script

import Splice.Api.Token.AllocationV1
import Splice.Api.Token.HoldingV1

import Dvp.Trade

import Treasury.Instrument
import Treasury.Rules (TreasuryRules(..))

import Tests.Dvp.SettlementFixture

canonicalSpecs : Fixture -> ContractId DvpTrade -> Script (AllocationSpecification, AllocationSpecification)
canonicalSpecs fixture tradeCid = do
  requestView <- requestViewOf fixture tradeCid
  treasurySpec <- legSpec requestView treasuryLegId
  paymentSpec <- legSpec requestView paymentLegId
  pure (treasurySpec, paymentSpec)

missingTreasuryLeg : Script ()
missingTreasuryLeg = do
  (fixture, tradeCid, _, paymentAllocationCid) <- allocatedTrade
  settleMustFail fixture tradeCid
    [ SettlementAllocation with
        transferLegId = paymentLegId
        allocationCid = paymentAllocationCid
        extraArgs = noExtraArgs
    ]
  assertNoAssetsMoved fixture

missingStablecoinLeg : Script ()
missingStablecoinLeg = do
  (fixture, tradeCid, treasuryAllocationCid, _) <- allocatedTrade
  settleMustFail fixture tradeCid
    [ SettlementAllocation with
        transferLegId = treasuryLegId
        allocationCid = treasuryAllocationCid
        extraArgs = noExtraArgs
    ]
  assertNoAssetsMoved fixture

emptyAllocationInput : Script ()
emptyAllocationInput = do
  (fixture, tradeCid, treasuryAllocationCid, paymentAllocationCid) <- allocatedTrade
  settleMustFail fixture tradeCid []
  assertSettlementUnchanged fixture tradeCid treasuryAllocationCid paymentAllocationCid

extraUnknownLeg : Script ()
extraUnknownLeg = do
  (fixture, tradeCid, treasuryAllocationCid, paymentAllocationCid) <- allocatedTrade
  settleMustFail fixture tradeCid
    (standardAllocations treasuryAllocationCid paymentAllocationCid <>
      [ SettlementAllocation with
          transferLegId = "fee-leg"
          allocationCid = paymentAllocationCid
          extraArgs = noExtraArgs
      ])
  assertSettlementUnchanged fixture tradeCid treasuryAllocationCid paymentAllocationCid

