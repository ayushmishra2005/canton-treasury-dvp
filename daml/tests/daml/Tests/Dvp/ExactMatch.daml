modifiedTreasuryAmount : Script ()
modifiedTreasuryAmount = do
  (fixture, tradeCid) <- initiatedTrade
  (treasurySpec, paymentSpec) <- canonicalSpecs fixture tradeCid
  deliveryHoldingCid <- issueDelivery fixture
  paymentHoldingCid <- mintPayment fixture
  treasuryAllocationCid <- allocateDelivery fixture
    (treasurySpec with transferLeg = treasurySpec.transferLeg with amount = 90.0)
    deliveryHoldingCid
  paymentAllocationCid <- allocatePayment fixture paymentSpec paymentHoldingCid
  settleMustFail fixture tradeCid (standardAllocations treasuryAllocationCid paymentAllocationCid)
  assertNoAssetsMoved fixture

modifiedStablecoinAmount : Script ()
modifiedStablecoinAmount = do
  (fixture, tradeCid) <- initiatedTrade
  (treasurySpec, paymentSpec) <- canonicalSpecs fixture tradeCid
  deliveryHoldingCid <- issueDelivery fixture
  paymentHoldingCid <- mintPayment fixture
  treasuryAllocationCid <- allocateDelivery fixture treasurySpec deliveryHoldingCid
  paymentAllocationCid <- allocatePayment fixture
    (paymentSpec with transferLeg = paymentSpec.transferLeg with amount = 90000.0)
    paymentHoldingCid
  settleMustFail fixture tradeCid (standardAllocations treasuryAllocationCid paymentAllocationCid)
  assertNoAssetsMoved fixture

modifiedSender : Script ()
modifiedSender = do
  (fixture, tradeCid) <- initiatedTrade
  (treasurySpec, paymentSpec) <- canonicalSpecs fixture tradeCid
  venueHoldingCid <- issueDeliveryTo fixture fixture.venue deliveryQuantity
  paymentHoldingCid <- mintPayment fixture
  treasuryAllocationCid <- allocateDelivery fixture
    (treasurySpec with transferLeg = treasurySpec.transferLeg with sender = fixture.venue)
    venueHoldingCid
  paymentAllocationCid <- allocatePayment fixture paymentSpec paymentHoldingCid
  settleMustFail fixture tradeCid (standardAllocations treasuryAllocationCid paymentAllocationCid)
  buyerSummary <- holdingSummary fixture.buyer
  filter (\(instrument, _, _) -> instrument == treasuryInstrumentName) buyerSummary === []

modifiedReceiver : Script ()
modifiedReceiver = do
  (fixture, tradeCid) <- initiatedTrade
  (treasurySpec, paymentSpec) <- canonicalSpecs fixture tradeCid
  deliveryHoldingCid <- issueDelivery fixture
  paymentHoldingCid <- mintPayment fixture
  treasuryAllocationCid <- allocateDelivery fixture
    (treasurySpec with transferLeg = treasurySpec.transferLeg with receiver = fixture.venue)
    deliveryHoldingCid
  paymentAllocationCid <- allocatePayment fixture paymentSpec paymentHoldingCid
  settleMustFail fixture tradeCid (standardAllocations treasuryAllocationCid paymentAllocationCid)
  assertNoAssetsMoved fixture

modifiedInstrument : Script ()
modifiedInstrument = do
  (fixture, tradeCid) <- initiatedTrade
  (treasurySpec, paymentSpec) <- canonicalSpecs fixture tradeCid
  otherInstrumentCid <- submit fixture.treasuryRegistry $ createCmd TreasuryInstrument with
    treasuryRegistry = fixture.treasuryRegistry
    id = "UST-2030-05"
    description = "US Treasury Note 2.0% due 2030-05-15"
    faceValue = 1000.0
    maturityDate = date 2030 May 15
  let otherInstrumentId = InstrumentId with
        admin = fixture.treasuryRegistry
        id = "UST-2030-05"
  otherRulesCid <- submit fixture.treasuryRegistry $
    createCmd TreasuryRules with instrumentId = otherInstrumentId
  otherHoldingCid <- submit fixture.treasuryRegistry $
    exerciseCmd otherInstrumentCid Issue with
      owner = fixture.seller
      amount = deliveryQuantity
  paymentHoldingCid <- mintPayment fixture
  treasuryAllocationCid <- allocateDeliveryVia fixture otherRulesCid
    (treasurySpec with transferLeg = treasurySpec.transferLeg with instrumentId = otherInstrumentId)
    otherHoldingCid
  paymentAllocationCid <- allocatePayment fixture paymentSpec paymentHoldingCid
  settleMustFail fixture tradeCid (standardAllocations treasuryAllocationCid paymentAllocationCid)
  assertNoAssetsMoved fixture

modifiedSettlementExecutor : Script ()
modifiedSettlementExecutor = do
  (fixture, tradeCid) <- initiatedTrade
  (treasurySpec, paymentSpec) <- canonicalSpecs fixture tradeCid
  deliveryHoldingCid <- issueDelivery fixture
  paymentHoldingCid <- mintPayment fixture
  let otherSettlement = treasurySpec.settlement with executor = fixture.seller
  treasuryAllocationCid <- allocateDelivery fixture
    (treasurySpec with settlement = otherSettlement)
    deliveryHoldingCid
  paymentAllocationCid <- allocatePayment fixture paymentSpec paymentHoldingCid
  settleMustFail fixture tradeCid (standardAllocations treasuryAllocationCid paymentAllocationCid)
  assertNoAssetsMoved fixture

