modifiedSettlementReference = do
  (fixture, tradeCid) <- initiatedTrade
  (treasurySpec, paymentSpec) <- canonicalSpecs fixture tradeCid
  deliveryHoldingCid <- issueDelivery fixture
  paymentHoldingCid <- mintPayment fixture
  let otherReference = Reference with id = "other-settlement", cid = None
      otherSettlement = treasurySpec.settlement with settlementRef = otherReference
  treasuryAllocationCid <- allocateDelivery fixture
    (treasurySpec with settlement = otherSettlement)
    deliveryHoldingCid
  paymentAllocationCid <- allocatePayment fixture paymentSpec paymentHoldingCid
  settleMustFail fixture tradeCid (standardAllocations treasuryAllocationCid paymentAllocationCid)
  assertNoAssetsMoved fixture

