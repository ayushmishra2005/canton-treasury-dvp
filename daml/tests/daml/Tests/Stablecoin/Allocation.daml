module Tests.Stablecoin.Allocation where

import DA.Assert ((===))
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, hours, minutes)
import Daml.Script

import Splice.Api.Token.AllocationV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1

import Stablecoin.Eligibility
import Stablecoin.Holding
import Stablecoin.Instrument
import Stablecoin.Rules

import Tests.Stablecoin.AllocationFixture

exactBalanceAllocationSucceeds : Script ()
exactBalanceAllocationSucceeds = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  (allocationCid, changeCids) <- allocate fixture (allocationSpec fixture 250.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  changeCids === []
  lockedCid <- lockedHoldingOf fixture.payer allocationCid
  Some locked <- queryContractId fixture.payer lockedCid
  locked.amount === 250.0
  locked.owner === fixture.payer
  locked.lock === Some Lock with
    holders = [fixture.cashRegistry]
    expiresAt = Some (addRelTime fixture.now (hours 2))
    expiresAfter = None
    context = Some "Settlement allocation"

overfundedAllocationCreatesChange : Script ()
overfundedAllocationCreatesChange = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  (_, changeCids) <- allocate fixture (allocationSpec fixture 150.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  case changeCids of
    [changeCid] -> do
      Some changeView <- queryInterfaceContractId @Holding fixture.payer changeCid
      changeView.amount === 100.0
      changeView.owner === fixture.payer
      changeView.lock === None
    _ -> abort "Expected exactly one change holding"

inputTotalEqualsLockedPlusChange : Script ()
inputTotalEqualsLockedPlusChange = do
  fixture <- setup
  firstCid <- mint fixture fixture.payer 175.0
  secondCid <- mint fixture fixture.payer 75.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  (allocationCid, _) <- allocate fixture (allocationSpec fixture 150.0) [firstCid, secondCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  lockedCid <- lockedHoldingOf fixture.payer allocationCid
  Some locked <- queryContractId fixture.payer lockedCid
  holdings <- queryInterface @Holding fixture.payer
  let total = sum [holdingView.amount | (_, Some holdingView) <- holdings]
  locked.amount === 150.0
  total === 250.0

allocationViewExposesSpecificationAndLockedHolding : Script ()
allocationViewExposesSpecificationAndLockedHolding = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  let spec = allocationSpec fixture 250.0
  (allocationCid, _) <- allocate fixture spec [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  Some allocationView <- queryInterfaceContractId @Allocation fixture.payee allocationCid
  allocationView.allocation === spec
  allocationView.meta === emptyMetadata
  lockedCid <- lockedHoldingOf fixture.payer allocationCid
  allocationView.holdingCids === [toInterfaceContractId @Holding lockedCid]

insufficientBalanceFails : Script ()
insufficientBalanceFails = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 100.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  allocateMustFail fixture (allocationSpec fixture 250.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

wrongHoldingOwnerFails : Script ()
wrongHoldingOwnerFails = do
  fixture <- setup
  payeeHoldingCid <- mint fixture fixture.payee 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  submitMustFail (actAs fixture.payer <> readAs [fixture.cashRegistry, fixture.payee]) $
    allocateAs fixture (allocationSpec fixture 250.0) [payeeHoldingCid]
      (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

wrongHoldingInstrumentFails : Script ()
wrongHoldingInstrumentFails = do
  fixture <- setup
  otherInstrumentCid <- submit fixture.cashRegistry $ createCmd StablecoinInstrument with
    cashRegistry = fixture.cashRegistry
    id = "EUR-C"
    description = "Regulated EUR payment stablecoin"
  otherHoldingCid <- submit fixture.cashRegistry $
    exerciseCmd otherInstrumentCid Mint with owner = fixture.payer, amount = 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  allocateMustFail fixture (allocationSpec fixture 250.0) [otherHoldingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

