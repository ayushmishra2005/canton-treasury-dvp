allocationAfterAllocateBeforeFails : Script ()
allocationAfterAllocateBeforeFails = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  passTime (minutes 90)
  allocateMustFail fixture (allocationSpec fixture 250.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

invalidDeadlineOrderingFails : Script ()
invalidDeadlineOrderingFails = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  let spec = allocationSpec fixture 250.0
      badSpec = spec with
        settlement = spec.settlement with
          settleBefore = addRelTime fixture.now (minutes 30)
  allocateMustFail fixture badSpec [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

suspendedEligibilityRejected : Script ()
suspendedEligibilityRejected = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- attest fixture fixture.payer Suspended (hours (-1)) (hours 24)
  receiverEligibilityCid <- eligible fixture fixture.payee
  allocateMustFail fixture (allocationSpec fixture 250.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

