  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- submit fixture.cashRegistry $ createCmd StablecoinEligibility with
    instrumentId = InstrumentId with admin = fixture.cashRegistry, id = "EUR-C"
    investor = fixture.payee
    status = Eligible
    validFrom = addRelTime fixture.now (hours (-1))
    validUntil = addRelTime fixture.now (hours 24)
    attestationRef = "attestation-000"
  allocateMustFail fixture (allocationSpec fixture 250.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

missingEligibilityContextRejected : Script ()
missingEligibilityContextRejected = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  _ <- eligible fixture fixture.payee
  allocateMustFail fixture (allocationSpec fixture 250.0) [holdingCid] noExtraArgs
  let senderOnly = ExtraArgs with
        context = ChoiceContext with
          values = TextMap.fromList
            [(senderEligibilityKey, AV_ContractId (coerceContractId senderEligibilityCid))]
        meta = emptyMetadata
  allocateMustFail fixture (allocationSpec fixture 250.0) [holdingCid] senderOnly

malformedEligibilityContextRejected : Script ()
malformedEligibilityContextRejected = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  let malformed = ExtraArgs with
        context = ChoiceContext with
          values = TextMap.fromList
            [ (senderEligibilityKey, AV_ContractId (coerceContractId senderEligibilityCid))
            , (receiverEligibilityKey, AV_Text "not-a-contract-id")
            ]
        meta = emptyMetadata
  allocateMustFail fixture (allocationSpec fixture 250.0) [holdingCid] malformed

splitRejectsLockedAllocationHolding : Script ()
splitRejectsLockedAllocationHolding = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  (allocationCid, _) <- allocate fixture (allocationSpec fixture 250.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  lockedCid <- lockedHoldingOf fixture.payer allocationCid
  submitMustFail fixture.payer $ exerciseCmd lockedCid Split with splitAmount = 100.0

mergeRejectsLockedAllocationHolding : Script ()
mergeRejectsLockedAllocationHolding = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  spareCid <- mint fixture fixture.payer 25.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  (allocationCid, _) <- allocate fixture (allocationSpec fixture 250.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  lockedCid <- lockedHoldingOf fixture.payer allocationCid
  submitMustFail fixture.payer $ exerciseCmd spareCid Merge with otherHoldingCid = lockedCid

burnCannotConsumeLockedAllocationHolding : Script ()
burnCannotConsumeLockedAllocationHolding = do
  fixture <- setup
  holdingCid <- mint fixture fixture.payer 250.0
  senderEligibilityCid <- eligible fixture fixture.payer
  receiverEligibilityCid <- eligible fixture fixture.payee
  (allocationCid, _) <- allocate fixture (allocationSpec fixture 250.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  lockedCid <- lockedHoldingOf fixture.payer allocationCid
  submitMustFail fixture.cashRegistry $ exerciseCmd lockedCid Burn
