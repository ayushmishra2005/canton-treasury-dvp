module Tests.Treasury.Allocation where

import DA.Assert ((===))
import DA.Date (Month(..), date)
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, hours, minutes)
import Daml.Script

import Splice.Api.Token.AllocationV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1

import Treasury.Eligibility
import Treasury.Holding
import Treasury.Instrument
import Treasury.Rules

import Tests.Treasury.AllocationFixture

exactBalanceAllocationSucceeds : Script ()
exactBalanceAllocationSucceeds = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  (allocationCid, changeCids) <- allocate fixture (allocationSpec fixture 100.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  changeCids === []
  lockedCid <- lockedHoldingOf fixture.seller allocationCid
  Some locked <- queryContractId fixture.seller lockedCid
  locked.amount === 100.0
  locked.owner === fixture.seller
  locked.lock === Some Lock with
    holders = [fixture.treasuryRegistry]
    expiresAt = Some (addRelTime fixture.now (hours 2))
    expiresAfter = None
    context = Some "Settlement allocation"

overfundedAllocationCreatesChange : Script ()
overfundedAllocationCreatesChange = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  (_, changeCids) <- allocate fixture (allocationSpec fixture 60.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  case changeCids of
    [changeCid] -> do
      Some changeView <- queryInterfaceContractId @Holding fixture.seller changeCid
      changeView.amount === 40.0
      changeView.owner === fixture.seller
      changeView.lock === None
    _ -> abort "Expected exactly one change holding"

inputTotalEqualsLockedPlusChange : Script ()
inputTotalEqualsLockedPlusChange = do
  fixture <- setup
  firstCid <- issue fixture fixture.seller 70.0
  secondCid <- issue fixture fixture.seller 30.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  (allocationCid, _) <- allocate fixture (allocationSpec fixture 60.0) [firstCid, secondCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  lockedCid <- lockedHoldingOf fixture.seller allocationCid
  Some locked <- queryContractId fixture.seller lockedCid
  holdings <- queryInterface @Holding fixture.seller
  let total = sum [holdingView.amount | (_, Some holdingView) <- holdings]
  locked.amount === 60.0
  total === 100.0

allocationViewExposesSpecificationAndLockedHolding : Script ()
allocationViewExposesSpecificationAndLockedHolding = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  let spec = allocationSpec fixture 100.0
  (allocationCid, _) <- allocate fixture spec [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  Some allocationView <- queryInterfaceContractId @Allocation fixture.buyer allocationCid
  allocationView.allocation === spec
  allocationView.meta === emptyMetadata
  lockedCid <- lockedHoldingOf fixture.seller allocationCid
  allocationView.holdingCids === [toInterfaceContractId @Holding lockedCid]

insufficientBalanceFails : Script ()
insufficientBalanceFails = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 40.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  allocateMustFail fixture (allocationSpec fixture 100.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

wrongHoldingOwnerFails : Script ()
wrongHoldingOwnerFails = do
  fixture <- setup
  buyerHoldingCid <- issue fixture fixture.buyer 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  submitMustFail (actAs fixture.seller <> readAs [fixture.treasuryRegistry, fixture.buyer]) $
    allocateAs fixture fixture.seller (allocationSpec fixture 100.0) [buyerHoldingCid]
      (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

wrongHoldingInstrumentFails : Script ()
wrongHoldingInstrumentFails = do
  fixture <- setup
  otherInstrumentCid <- submit fixture.treasuryRegistry $ createCmd TreasuryInstrument with
    treasuryRegistry = fixture.treasuryRegistry
    id = "UST-2030-05"
    description = "US Treasury Note 2.0% due 2030-05-15"
    faceValue = 1000.0
    maturityDate = date 2030 May 15
  otherHoldingCid <- submit fixture.treasuryRegistry $
    exerciseCmd otherInstrumentCid Issue with owner = fixture.seller, amount = 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  allocateMustFail fixture (allocationSpec fixture 100.0) [otherHoldingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

