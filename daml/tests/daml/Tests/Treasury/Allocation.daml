allocationAfterAllocateBeforeFails : Script ()
allocationAfterAllocateBeforeFails = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  passTime (minutes 90)
  allocateMustFail fixture (allocationSpec fixture 100.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

invalidDeadlineOrderingFails : Script ()
invalidDeadlineOrderingFails = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  let spec = allocationSpec fixture 100.0
      badSpec = spec with
        settlement = spec.settlement with
          settleBefore = addRelTime fixture.now (minutes 30)
  allocateMustFail fixture badSpec [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

suspendedEligibilityRejected : Script ()
suspendedEligibilityRejected = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- attest fixture fixture.seller Suspended (hours (-1)) (hours 24)
  receiverEligibilityCid <- eligible fixture fixture.buyer
  allocateMustFail fixture (allocationSpec fixture 100.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

