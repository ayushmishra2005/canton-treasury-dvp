  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- submit fixture.treasuryRegistry $ createCmd TreasuryEligibility with
    instrumentId = InstrumentId with admin = fixture.treasuryRegistry, id = "UST-2030-05"
    investor = fixture.buyer
    status = Eligible
    validFrom = addRelTime fixture.now (hours (-1))
    validUntil = addRelTime fixture.now (hours 24)
    attestationRef = "attestation-000"
  allocateMustFail fixture (allocationSpec fixture 100.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)

missingEligibilityContextRejected : Script ()
missingEligibilityContextRejected = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  _ <- eligible fixture fixture.buyer
  allocateMustFail fixture (allocationSpec fixture 100.0) [holdingCid] noExtraArgs
  let senderOnly = ExtraArgs with
        context = ChoiceContext with
          values = TextMap.fromList
            [(senderEligibilityKey, AV_ContractId (coerceContractId senderEligibilityCid))]
        meta = emptyMetadata
  allocateMustFail fixture (allocationSpec fixture 100.0) [holdingCid] senderOnly

malformedEligibilityContextRejected : Script ()
malformedEligibilityContextRejected = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  let malformed = ExtraArgs with
        context = ChoiceContext with
          values = TextMap.fromList
            [ (senderEligibilityKey, AV_ContractId (coerceContractId senderEligibilityCid))
            , (receiverEligibilityKey, AV_Text "not-a-contract-id")
            ]
        meta = emptyMetadata
  allocateMustFail fixture (allocationSpec fixture 100.0) [holdingCid] malformed

splitRejectsLockedAllocationHolding : Script ()
splitRejectsLockedAllocationHolding = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  (allocationCid, _) <- allocate fixture (allocationSpec fixture 100.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  lockedCid <- lockedHoldingOf fixture.seller allocationCid
  submitMustFail fixture.seller $ exerciseCmd lockedCid Split with splitAmount = 40.0

mergeRejectsLockedAllocationHolding : Script ()
mergeRejectsLockedAllocationHolding = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  spareCid <- issue fixture fixture.seller 25.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  (allocationCid, _) <- allocate fixture (allocationSpec fixture 100.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  lockedCid <- lockedHoldingOf fixture.seller allocationCid
  submitMustFail fixture.seller $ exerciseCmd spareCid Merge with otherHoldingCid = lockedCid
