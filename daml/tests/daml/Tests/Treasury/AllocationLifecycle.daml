module Tests.Treasury.AllocationLifecycle where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Time (hours)
import Daml.Script

import Splice.Api.Token.AllocationV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1

import Treasury.Eligibility

import Tests.Treasury.AllocationFixture

allocated : Script (Fixture, ContractId Allocation)
allocated = do
  fixture <- setup
  holdingCid <- issue fixture fixture.seller 100.0
  senderEligibilityCid <- eligible fixture fixture.seller
  receiverEligibilityCid <- eligible fixture fixture.buyer
  (allocationCid, _) <- allocate fixture (allocationSpec fixture 100.0) [holdingCid]
    (eligibilityArgs senderEligibilityCid receiverEligibilityCid)
  pure (fixture, allocationCid)

settlementParties : Fixture -> [Party]
settlementParties fixture = [fixture.executor, fixture.seller, fixture.buyer]

jointlyAuthorizedExecutionSucceeds : Script ()
jointlyAuthorizedExecutionSucceeds = do
  (fixture, allocationCid) <- allocated
  result <- submit (actAs (settlementParties fixture) <> readAs fixture.treasuryRegistry) $
    exerciseCmd allocationCid Allocation_ExecuteTransfer with extraArgs = noExtraArgs
  result.senderHoldingCids === []
  length result.receiverHoldingCids === 1

executionCreatesReceiverHolding : Script ()
executionCreatesReceiverHolding = do
  (fixture, allocationCid) <- allocated
  result <- submit (actAs (settlementParties fixture) <> readAs fixture.treasuryRegistry) $
    exerciseCmd allocationCid Allocation_ExecuteTransfer with extraArgs = noExtraArgs
  case result.receiverHoldingCids of
    [receiverHoldingCid] -> do
      Some receiverView <- queryInterfaceContractId @Holding fixture.buyer receiverHoldingCid
      receiverView.owner === fixture.buyer
      receiverView.amount === 100.0
      receiverView.lock === None
      receiverView.instrumentId === fixture.instrumentId
    _ -> abort "Expected exactly one receiver holding"
  sellerHoldings <- queryInterface @Holding fixture.seller
  sellerHoldings === []

executorAloneCannotExecute : Script ()
executorAloneCannotExecute = do
  (fixture, allocationCid) <- allocated
  submitMustFail
    (actAs fixture.executor
      <> readAs [fixture.treasuryRegistry, fixture.seller, fixture.buyer]) $
    exerciseCmd allocationCid Allocation_ExecuteTransfer with extraArgs = noExtraArgs

executionAfterSettleBeforeFails : Script ()
executionAfterSettleBeforeFails = do
  (fixture, allocationCid) <- allocated
  passTime (hours 3)
  submitMustFail (actAs (settlementParties fixture) <> readAs fixture.treasuryRegistry) $
    exerciseCmd allocationCid Allocation_ExecuteTransfer with extraArgs = noExtraArgs

jointCancellationRestoresSenderHolding : Script ()
jointCancellationRestoresSenderHolding = do
  (fixture, allocationCid) <- allocated
  result <- submit (actAs (settlementParties fixture) <> readAs fixture.treasuryRegistry) $
    exerciseCmd allocationCid Allocation_Cancel with extraArgs = noExtraArgs
  case result.senderHoldingCids of
    [senderHoldingCid] -> do
      Some senderView <- queryInterfaceContractId @Holding fixture.seller senderHoldingCid
      senderView.owner === fixture.seller
      senderView.amount === 100.0
      senderView.lock === None
    _ -> abort "Expected exactly one restored sender holding"
  buyerHoldings <- queryInterface @Holding fixture.buyer
  buyerHoldings === []

senderCannotCancelAlone : Script ()
senderCannotCancelAlone = do
  (fixture, allocationCid) <- allocated
  submitMustFail
    (actAs fixture.seller
      <> readAs [fixture.treasuryRegistry, fixture.executor, fixture.buyer]) $
    exerciseCmd allocationCid Allocation_Cancel with extraArgs = noExtraArgs

senderWithdrawalRestoresSenderHolding : Script ()
senderWithdrawalRestoresSenderHolding = do
  (fixture, allocationCid) <- allocated
  result <- submit (actAs fixture.seller <> readAs fixture.treasuryRegistry) $
    exerciseCmd allocationCid Allocation_Withdraw with extraArgs = noExtraArgs
  case result.senderHoldingCids of
    [senderHoldingCid] -> do
      Some senderView <- queryInterfaceContractId @Holding fixture.seller senderHoldingCid
      senderView.owner === fixture.seller
      senderView.amount === 100.0
      senderView.lock === None
    _ -> abort "Expected exactly one restored sender holding"

senderWithdrawsAfterExpiryWithoutOtherParties : Script ()
senderWithdrawsAfterExpiryWithoutOtherParties = do
  (fixture, allocationCid) <- allocated
  passTime (hours 3)
  result <- submit (actAs fixture.seller <> readAs fixture.treasuryRegistry) $
    exerciseCmd allocationCid Allocation_Withdraw with extraArgs = noExtraArgs
  length result.senderHoldingCids === 1
  holdings <- queryInterface @Holding fixture.seller
  map snd holdings === [Some HoldingView with
    owner = fixture.seller
    instrumentId = fixture.instrumentId
    amount = 100.0
    lock = None
    meta = emptyMetadata]

executeFetchesNoEligibilityOrRules : Script ()
executeFetchesNoEligibilityOrRules = do
  (fixture, allocationCid) <- allocated
  retireEligibilityAndRules fixture
  result <- submit (actAs (settlementParties fixture) <> readAs fixture.treasuryRegistry) $
    exerciseCmd allocationCid Allocation_ExecuteTransfer with extraArgs = noExtraArgs
  length result.receiverHoldingCids === 1

cancelFetchesNoEligibilityOrRules : Script ()
cancelFetchesNoEligibilityOrRules = do
  (fixture, allocationCid) <- allocated
  retireEligibilityAndRules fixture
  result <- submit (actAs (settlementParties fixture) <> readAs fixture.treasuryRegistry) $
    exerciseCmd allocationCid Allocation_Cancel with extraArgs = noExtraArgs
  length result.senderHoldingCids === 1

withdrawFetchesNoEligibilityOrRules : Script ()
withdrawFetchesNoEligibilityOrRules = do
  (fixture, allocationCid) <- allocated
  retireEligibilityAndRules fixture
  result <- submit (actAs fixture.seller <> readAs fixture.treasuryRegistry) $
    exerciseCmd allocationCid Allocation_Withdraw with extraArgs = noExtraArgs
  length result.senderHoldingCids === 1

retireEligibilityAndRules : Fixture -> Script ()
retireEligibilityAndRules fixture = do
  eligibilities <- query @TreasuryEligibility fixture.treasuryRegistry
  forA_ eligibilities $ \(eligibilityCid, _) ->
    submit fixture.treasuryRegistry $ exerciseCmd eligibilityCid Revoke
  submit fixture.treasuryRegistry $ archiveCmd fixture.rulesCid
