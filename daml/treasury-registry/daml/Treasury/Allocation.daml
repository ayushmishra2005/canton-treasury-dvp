module Treasury.Allocation where

import Splice.Api.Token.AllocationV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1

import Treasury.Holding

template TreasuryAllocation
  with
    allocation : AllocationSpecification
    lockedHoldingCid : ContractId TreasuryHolding
  where
    signatory allocation.transferLeg.instrumentId.admin
    observer
      allocation.transferLeg.sender,
      allocation.transferLeg.receiver,
      allocation.settlement.executor

    interface instance Allocation for TreasuryAllocation where
      view = AllocationView with
        allocation
        holdingCids = [toInterfaceContractId @Holding lockedHoldingCid]
        meta = emptyMetadata

      allocation_executeTransferImpl _self _arg = do
        now <- getTime
        assertMsg "Settlement deadline has passed" (now < allocation.settlement.settleBefore)
        archive lockedHoldingCid
        receiverHoldingCid <- create TreasuryHolding with
          instrumentId = allocation.transferLeg.instrumentId
          owner = allocation.transferLeg.receiver
          amount = allocation.transferLeg.amount
          lock = None
        pure Allocation_ExecuteTransferResult with
          senderHoldingCids = []
          receiverHoldingCids = [toInterfaceContractId @Holding receiverHoldingCid]
          meta = emptyMetadata

      allocation_cancelImpl _self _arg = do
        senderHoldingCid <- returnToSender allocation lockedHoldingCid
        pure Allocation_CancelResult with
          senderHoldingCids = [senderHoldingCid]
          meta = emptyMetadata

      allocation_withdrawImpl _self _arg = do
        senderHoldingCid <- returnToSender allocation lockedHoldingCid
        pure Allocation_WithdrawResult with
          senderHoldingCids = [senderHoldingCid]
          meta = emptyMetadata

returnToSender : AllocationSpecification -> ContractId TreasuryHolding -> Update (ContractId Holding)
returnToSender allocation lockedHoldingCid = do
  archive lockedHoldingCid
  senderHoldingCid <- create TreasuryHolding with
    instrumentId = allocation.transferLeg.instrumentId
    owner = allocation.transferLeg.sender
    amount = allocation.transferLeg.amount
    lock = None
  pure (toInterfaceContractId @Holding senderHoldingCid)
